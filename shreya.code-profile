{"name":"shreya","settings":"{\"settings\":\"{\\r\\n    \\\"editor.linkedEditing\\\": true,\\r\\n    \\\"livePreview.customExternalBrowser\\\": \\\"Chrome\\\",\\r\\n    \\\"livePreview.openPreviewTarget\\\": \\\"External Browser\\\",\\r\\n    \\\"[css]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\r\\n    },\\r\\n    \\\"[html]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\r\\n    },\\r\\n    \\\"editor.fontFamily\\\": \\\"fira code\\\",\\r\\n    \\\"cSpell.userWords\\\": [\\r\\n        \\\"Doraemon\\\"\\r\\n    ],\\r\\n    \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\r\\n    \\\"explorer.confirmDelete\\\": false,\\r\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\r\\n    \\\"editor.renderWhitespace\\\": \\\"boundary\\\",\\r\\n    \\\"editor.mouseWheelZoom\\\": true,\\r\\n    \\\"window.systemColorTheme\\\": \\\"dark\\\",\\r\\n    \\\"window.customTitleBarVisibility\\\": \\\"windowed\\\",\\r\\n    \\\"window.newWindowDimensions\\\": \\\"inherit\\\",\\r\\n    \\\"extensions.autoUpdate\\\": false,\\r\\n    \\\"window.menuBarVisibility\\\": \\\"visible\\\",\\r\\n    \\\"workbench.colorTheme\\\": \\\"One Dark Pro Flat\\\",\\r\\n    \\\"workbench.colorCustomizations\\\": {\\r\\n        \\\"terminal.background\\\": \\\"#00000000\\\"\\r\\n    },\\r\\n    \\\"window.titleBarStyle\\\": \\\"custom\\\",\\r\\n    \\\"emmet.useInlineCompletions\\\": true,\\r\\n    \\\"terminal.integrated.gpuAcceleration\\\": \\\"off\\\",\\r\\n    \\\"window.autoDetectColorScheme\\\": false,\\r\\n    \\\"editor.fontSize\\\": 16,\\r\\n    \\\"emmet.optimizeStylesheetParsing\\\": false,\\r\\n    \\\"tailwindCSS.emmetCompletions\\\": true,\\r\\n    \\\"window.newWindowProfile\\\": \\\"Default\\\"\\r\\n}\\r\\n\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaultsauto[]\\r\\n[\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+q\\\",\\r\\n        \\\"command\\\": \\\"-workbench.action.quickOpenView\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+q\\\",\\r\\n        \\\"command\\\": \\\"-workbench.action.quickOpenNavigateNextInViewPicker\\\",\\r\\n        \\\"when\\\": \\\"inQuickOpen && inViewsPicker\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+q\\\",\\r\\n        \\\"command\\\": \\\"editor.action.selectHighlights\\\",\\r\\n        \\\"when\\\": \\\"editorFocus\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+l\\\",\\r\\n        \\\"command\\\": \\\"-editor.action.selectHighlights\\\",\\r\\n        \\\"when\\\": \\\"editorFocus\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+enter\\\",\\r\\n        \\\"command\\\": \\\"editor.action.deleteLines\\\",\\r\\n        \\\"when\\\": \\\"textInputFocus && !editorReadonly\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+k\\\",\\r\\n        \\\"command\\\": \\\"-editor.action.deleteLines\\\",\\r\\n        \\\"when\\\": \\\"textInputFocus && !editorReadonly\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"f1\\\",\\r\\n        \\\"command\\\": \\\"workbench.action.debug.run\\\",\\r\\n        \\\"when\\\": \\\"debuggersAvailable && debugState != 'initializing'\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+f5\\\",\\r\\n        \\\"command\\\": \\\"-workbench.action.debug.run\\\",\\r\\n        \\\"when\\\": \\\"debuggersAvailable && debugState != 'initializing'\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+f\\\",\\r\\n        \\\"command\\\": \\\"editor.fold\\\",\\r\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+oem_4\\\",\\r\\n        \\\"command\\\": \\\"-editor.fold\\\",\\r\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+alt+f\\\",\\r\\n        \\\"command\\\": \\\"editor.foldAll\\\",\\r\\n        